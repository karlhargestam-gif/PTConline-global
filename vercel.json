{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.ptconline.global" }],
      "destination": "https://ptconline.global/:path",
      "statusCode": 301
    },
    {
      "source": "/:path(.*)/",
      "destination": "/:path",
      "statusCode": 308
    }
  ]
}
